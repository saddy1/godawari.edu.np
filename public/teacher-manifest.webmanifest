{
  "id": "/admin/teacher/workspace",
  "name": "Teacher Workspace",
  "short_name": "Teacher",
  "start_url": "/admin/teacher/workspace?source=pwa",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
  "theme_color": "#0b2415",
  "categories": ["education", "productivity"],
  "description": "Mobile teacher workspace for routine attendance and examination marks.",
  "icons": [
    { "src": "/icons/teacher/icon-any-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/teacher/icon-any-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/teacher/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/teacher/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Take attendance",
      "short_name": "Attendance",
      "url": "/admin/teacher/workspace?source=pwa#today-classes",
      "icons": [{ "src": "/icons/teacher/icon-any-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Enter marks",
      "short_name": "Exams",
      "url": "/admin/examinations?source=pwa",
      "icons": [{ "src": "/icons/teacher/icon-any-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
