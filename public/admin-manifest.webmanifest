{
  "id": "/admin/dashboard",
  "name": "School Admin",
  "short_name": "Admin",
  "start_url": "/admin/dashboard?source=pwa",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
